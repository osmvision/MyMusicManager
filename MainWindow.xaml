<Window x:Class="MyMusicManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyMusicManager - Urban Edition" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushMainBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="MY MUSIC" FontSize="14" Foreground="{StaticResource BrushSubText}"/>
            <TextBlock Text="MANAGER" FontSize="48" FontWeight="Black" Foreground="White" FontFamily="Arial Black">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#BB00FF" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <Border Height="4" Width="100" HorizontalAlignment="Left" Background="{StaticResource BrushNeon}" CornerRadius="2" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,25">
            <Button Content="+ NEW DROP (API)" Click="BtnAdd_Click" Width="180" Margin="0,0,15,0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#BB00FF" Offset="0"/>
                        <GradientStop Color="#8800CC" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            
            <Button Content="STATS / VIZ" Click="BtnStats_Click" Width="150" Margin="0,0,15,0"/>
            
            <Button Content="EXPORT PDF" Click="BtnExport_Click" Width="150" BorderBrush="#FF3366">
                 <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                         <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF3366" BlurRadius="20" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="BorderBrush" Value="#FF3366"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Border Grid.Row="2" Background="#11FFFFFF" CornerRadius="15" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="2">
            <DataGrid x:Name="GridAlbums" AutoGenerateColumns="False" IsReadOnly="True" Margin="10">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="COVER" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Width="60" Height="60" Margin="5">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding UrlPochette}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="5" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="TRACK / ALBUM" Binding="{Binding Titre}" Width="*" FontWeight="Bold" FontSize="14"/>
                    <DataGridTextColumn Header="ARTIST" Binding="{Binding Artiste.Nom}" Width="180" Foreground="{StaticResource BrushSubText}"/>
                    <DataGridTextColumn Header="YEAR" Binding="{Binding Annee}" Width="80"/>
                    <DataGridTextColumn Header="PRICE" Binding="{Binding Prix, StringFormat={}{0} €}" Width="80" FontWeight="Bold" Foreground="{StaticResource BrushNeon}"/>

                    <DataGridTemplateColumn Header="ACTION" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="DEL" Click="BtnDelete_Click" 
                                        Width="60" Height="30"
                                        Foreground="#FF3366" BorderBrush="#FF3366" 
                                        Background="Transparent" FontWeight="Bold" FontSize="12">
                                     <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                             <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF3366" BlurRadius="15" ShadowDepth="0"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>