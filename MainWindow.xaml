<Window x:Class="MyMusicManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyMusicManager - Ma Collection" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ma Collection Musicale" FontSize="28" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,20">
            <Button Content="+ Nouvel Album (API)" Width="150" Height="40" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button Content="Voir Statistiques" Width="140" Height="40" Background="#28A745" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="BtnStats_Click"/>
            <Button Content="Exporter PDF" Width="120" Height="40" Background="#DC3545" Foreground="White" FontWeight="Bold" Click="BtnExport_Click"/>
        </StackPanel>

        <DataGrid x:Name="GridAlbums" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderBrush="#CCC" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Pochette" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding UrlPochette}" Width="50" Height="50" Stretch="UniformToFill"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Titre" Binding="{Binding Titre}" Width="*" FontWeight="Bold"/>
                <DataGridTextColumn Header="Artiste" Binding="{Binding Artiste.Nom}" Width="150"/>
                <DataGridTextColumn Header="Année" Binding="{Binding Annee}" Width="80"/>
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="80"/>
                <DataGridTextColumn Header="Prix (€)" Binding="{Binding Prix}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>

