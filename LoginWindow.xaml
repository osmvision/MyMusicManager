<Window x:Class="MyMusicManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushMainBackground}">

    <Border Background="#10FFFFFF" CornerRadius="20" Margin="30" BorderBrush="#33BB00FF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="10" Opacity="0.4"/>
        </Border.Effect>
        
        <StackPanel VerticalAlignment="Center" Margin="20">
            <TextBlock Text="ACCESS" Foreground="{StaticResource BrushSubText}" HorizontalAlignment="Center" Opacity="0.8"/>
            <TextBlock Text="CONTROL" Foreground="White" FontSize="32" FontWeight="Black" FontFamily="Arial Black" HorizontalAlignment="Center" Margin="0,0,0,30">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#BB00FF" BlurRadius="10" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="USERNAME" Foreground="{StaticResource BrushNeon}" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Height="35" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="PASSWORD" Foreground="{StaticResource BrushNeon}" FontWeight="Bold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="35" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,25"
                         Background="{StaticResource BrushUrbanShadow}" Foreground="White" BorderBrush="#442266" BorderThickness="0,0,0,2"/>

            <Button Content="ENTER SYSTEM" Click="Button_Click" Height="45" FontSize="16">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#BB00FF" Offset="0"/>
                        <GradientStop Color="#8800CC" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <TextBlock x:Name="lblError" Foreground="#FF3366" Margin="0,15,0,0" HorizontalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
    </Border>
</Window>