<Window x:Class="MyMusicManager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Connexion MyMusicManager" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Identifiant :" />
            <TextBox x:Name="txtUsername" Margin="0,0,0,10"/>
            
            <TextBlock Text="Mot de passe :" />
            <PasswordBox x:Name="txtPassword" Margin="0,0,0,20"/>
            
            <Button Content="Se Connecter" Click="Button_Click" Height="30" Background="#DDDDDD"/>
            <TextBlock x:Name="lblError" Foreground="Red" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>