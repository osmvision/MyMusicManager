<Window x:Class="MyMusicManager.AddAlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un Album via API" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Artiste :" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <TextBox x:Name="txtSearch" Width="300" Height="30" VerticalContentAlignment="Center"/>
            <Button Content="🔍 Rechercher sur iTunes" Click="BtnSearch_Click" Width="150" Margin="10,0,0,0" Background="#007ACC" Foreground="White"/>
        </StackPanel>

        <ListBox x:Name="ListResults" Grid.Row="1" Margin="0,0,0,15" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5" Width="600">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding ArtworkUrl100}" Width="50" Height="50"/>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CollectionName}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding ArtistName}" Foreground="Gray"/>
                                <TextBlock Text="{Binding ReleaseDate}" FontSize="10"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Enregistrer" Click="BtnSave_Click" Tag="{Binding}" VerticalAlignment="Center" Padding="10,5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="Fermer" Click="BtnClose_Click" HorizontalAlignment="Right" Width="100" Height="30"/>
    </Grid>
</Window>